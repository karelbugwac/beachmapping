# Supabase Configuration
# NEXT_PUBLIC_ variables are accessible in browser client code
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server Service Role (SECRET - Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ADMIN_INITIAL_PIN=replace-with-a-random-6-digit-admin-pin
# Optional dedicated HMAC key; if omitted, SUPABASE_SERVICE_ROLE_KEY is used.
PIN_LOOKUP_SECRET=replace-with-a-long-random-secret

# Google Gemini API Key (Server-only for AI assistant)
GEMINI_API_KEY=your-gemini-api-key-here

# Stormglass Tidal API Key (Server-only for scheduled cron caching)
STORMGLASS_API_KEY=your-stormglass-api-key-here

# Email Provider Configuration (Resend or SMTP)
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM="Dagat Ta Bai <notifications@dagattabai.ph>"
MAIL_USERNAME=your-smtp-account@example.com
MAIL_PASSWORD=your-smtp-app-password

# Next.js App Base URL (used for welcome email links and callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for securing cron and webhook endpoints
CRON_SECRET=your-random-cron-secret-token
WEBHOOK_SECRET=your-random-webhook-secret-token
